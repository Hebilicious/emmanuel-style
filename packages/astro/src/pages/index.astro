---
import ExternalLink from "../components/ExternalLink.astro"
import Github from "../components/Github.astro"
import LinkedIn from "../components/LinkedIn.astro"
import Quotes from "../components/Quotes.vue"
import Twitter from "../components/Twitter.astro"
import Layout from "../layouts/Layout.astro"

const iconHeight = "1.125rem"

const identity = ["Digital Citizen", "International Empire", "Earth Republic"]

const sections = [
	{
		href: "/library",
		label: "library",
		blurb: "Open source modules, tools and templates, listed by shelf."
	},
	{
		href: "/blog",
		label: "blog",
		blurb: "Long-form writing on philosophy, science and history."
	},
	{
		href: "/experience",
		label: "experience",
		blurb: "Roles, education and the ledger of what came before."
	}
]
---

<Layout title="Emmanuel" masthead="The Emmanuel Style" section="front page">
  <div class="Front">
    <section class="Identity">
      <div class="Who">
        <h2 class="display Name">Emmanuel LD</h2>
        <ul class="Lines">
          {identity.map((line) => <li class="Line">{line}</li>)}
        </ul>
        <div class="Icons">
          <ExternalLink label="twitter" url="twitter.com/its_hebilicious">
            <Twitter iconHeight={iconHeight} />
          </ExternalLink>
          <ExternalLink label="github" url="github.com/Hebilicious">
            <Github iconHeight={iconHeight} />
          </ExternalLink>
          <ExternalLink
            label="linkedIn"
            url="www.linkedin.com/in/emmanuel-donnet">
            <LinkedIn iconHeight={iconHeight} />
          </ExternalLink>
        </div>
      </div>
      <img
        class="Portrait"
        src="/images/Profile.png"
        width="100"
        height="100"
        alt="Profile Picture"
        loading="eager"
      />
    </section>

    <nav class="Index" aria-label="Sections">
      {sections.map((section) => (
        <a class="Entry" href={section.href}>
          <span class="Key label">[{section.label}]</span>
          <span class="Blurb">{section.blurb}</span>
          <span class="Arrow" aria-hidden="true">
            →
          </span>
        </a>
      ))}
    </nav>

    <section class="Quote span-all" aria-label="Quote">
      <p class="Key label">quote</p>
      <Quotes client:load data-quotes />
    </section>
  </div>
</Layout>

<style>
.Identity {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: var(--spacing_fluid-column-space-column-s);
  padding-bottom: var(--spacing_fluid-flow-space-m);
  border-bottom: var(--spacing-size-rule) double var(--rule-strong);
}

.Who {
  display: flex;
  flex-direction: column;
  gap: var(--spacing_fluid-tight-space-tight-m);
  min-width: 0;
}

.Name {
  font-size: var(--typography_fluid-display-font-size-display-m);
  text-transform: uppercase;
}

.Lines {
  display: flex;
  flex-direction: column;
}

.Line {
  color: var(--muted);
  font-size: var(--typography_fluid-micro-font-size-micro-m);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.Icons {
  display: flex;
  gap: var(--spacing_fluid-tight-space-tight-l);
  padding-top: var(--spacing_fluid-tight-space-tight-s);
}

.Portrait {
  width: clamp(4.5rem, 3rem + 6vw, 7rem);
  height: auto;
  aspect-ratio: 1;
  object-fit: cover;
  border: var(--spacing-size-hairline) solid var(--rule-strong);
  outline: var(--spacing-size-hairline) solid var(--rule);
  outline-offset: 3px;
  /* Newspaper cut: the portrait keeps its shape, loses its colour. */
  filter: grayscale(1) contrast(1.12);
}

.Index {
  display: grid;
  padding-block: var(--spacing_fluid-tight-space-tight-s);
}

.Entry {
  display: grid;
  grid-template-columns: 11ch minmax(0, 1fr) auto;
  align-items: baseline;
  gap: var(--spacing_fluid-tight-space-tight-m);
  padding-block: var(--spacing_fluid-tight-space-tight-l);
  border-bottom: var(--spacing-size-hairline) solid var(--rule);
  transition: color 120ms linear;
}

.Entry:last-child {
  border-bottom: 0;
}

.Entry:hover .Blurb,
.Entry:hover .Arrow {
  color: var(--ink);
}

.Entry:hover .Key {
  color: var(--accent);
}

.Key {
  color: var(--muted);
  text-transform: lowercase;
  transition: color 120ms linear;
}

.Blurb {
  color: var(--muted);
  transition: color 120ms linear;
}

.Arrow {
  color: var(--faint);
  transition: color 120ms linear;
}

.Quote {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--spacing_fluid-tight-space-tight-m);
  padding: var(--spacing_fluid-flow-space-s);
  border: var(--spacing-size-hairline) solid var(--rule);
  border-left: var(--spacing-size-rule) solid var(--accent);
  background: var(--surface);
}

.Quote .Key {
  color: var(--accent);
}

/*
 * Broadsheet front page: the lead runs wide, the section index sits beside it
 * as the supporting column, and the quote spans the foot. Collapses to one
 * column when there is no room for two.
 */
/*
 * The front page fills the screen.
 *
 * It was sized to its content, so the whole page sat in the top third with a large
 * empty area below it. The identity and index rows take what they need and the
 * quote row absorbs the rest, which is what makes the page read as a full screen.
 */
.Front {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  grid-template-rows: auto minmax(0, 1fr);
  column-gap: var(--spacing_fluid-column-space-column-s);
  row-gap: var(--spacing_fluid-flow-space-m);
  align-items: start;
  min-height: 100%;
}

.Front .Identity {
  grid-column: 1;
}

/* The quote is the foot of the page, spanning both columns. */
.Front .span-all {
  grid-column: 1 / -1;
}

.Front .Index {
  grid-column: 2;
  padding-block: 0;
  padding-left: var(--spacing_fluid-column-space-column-s);
  border-left: var(--spacing-size-hairline) solid var(--rule);
}

@media (max-width: 60rem) {
  .Front {
    grid-template-columns: minmax(0, 1fr);
  }

  .Front .Index {
    grid-column: 1;
    padding-left: 0;
    border-left: 0;
  }
}

@media (max-width: 34rem) {
  .Identity {
    grid-template-columns: 1fr;
  }

  .Portrait {
    grid-row: 1;
    width: 5rem;
  }

  .Entry {
    grid-template-columns: 1fr auto;
    row-gap: var(--spacing_fluid-tight-space-tight-xs);
  }

  .Blurb {
    grid-column: 1 / -1;
  }
}
</style>
