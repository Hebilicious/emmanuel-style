---
import { getCollection } from "astro:content"
import FavouriteButton from "../../components/FavouriteButton.vue"
import Layout from "../../layouts/Layout.astro"

const entries = await getCollection("blog", ({ data }) => data.draft !== true)

const sorted = entries.sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("en-GB", {
		year: "numeric",
		month: "long",
		day: "numeric"
	}).format(date)
---

<Layout
  title="Blog - Emmanuel"
  path="/blog"
  masthead="The Blog"
  section="dispatches">
  <ul class="Entries" data-flow data-columns>
    {sorted.map((entry) => (
      <li class="Entry">
        <div class="Row">
          <a class="EntryLink" href={`/blog/${entry.id}`}>
            <span class="Head">
              <span class="EntryTitle display">{entry.data.title}</span>
              <time
                class="Date"
                datetime={entry.data.publishDate.toISOString()}>
                {formatDate(entry.data.publishDate)}
              </time>
            </span>
            <span class="Description">{entry.data.description}</span>
            {entry.data.tags.length > 0 && (
              <span class="Tags">
                {entry.data.tags.map((tag) => <span class="Tag">#{tag}</span>)}
              </span>
            )}
          </a>
          <FavouriteButton client:visible slug={entry.id} />
        </div>
      </li>
    ))}
  </ul>
</Layout>

<style>
.Intro {
  max-width: 60ch;
  padding-bottom: var(--spacing_fluid-flow-space-s);
  border-bottom: var(--spacing-size-rule) double var(--rule-strong);
  color: var(--muted);
}

.Entry {
  border-bottom: var(--spacing-size-hairline) solid var(--rule);
}

.Entry:last-child {
  border-bottom: 0;
}

.Row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: var(--spacing_fluid-flow-space-s);
}

.EntryLink {
  display: flex;
  flex-direction: column;
  gap: var(--spacing_fluid-tight-space-tight-s);
  padding-block: var(--spacing_fluid-tight-space-tight-l);
  min-width: 0;
}

.EntryLink:hover .EntryTitle {
  color: var(--accent);
}

.Head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: var(--spacing_fluid-flow-space-s);
}

/*
 * The display face at column width would otherwise wrap into three lines and
 * dominate the row, so the index sizes it like a headline rather than a
 * masthead and keeps it to a couple of lines.
 */
.EntryTitle {
  font-size: var(--typography_fluid-content-font-size-m);
  line-height: 1.15;
  text-wrap: balance;
  transition: color 120ms linear;
}

.Date {
  flex-shrink: 0;
  color: var(--faint);
  font-size: var(--typography_fluid-micro-font-size-micro-s);
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.Description {
  max-width: 58ch;
  color: var(--muted);
}

.Tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing_fluid-tight-space-tight-m);
  color: var(--faint);
  font-size: var(--typography_fluid-micro-font-size-micro-s);
  letter-spacing: 0.08em;
}

@media (max-width: 40rem) {
  .Head {
    flex-direction: column;
    gap: var(--spacing_fluid-tight-space-tight-xs);
  }

  .Row {
    grid-template-columns: 1fr;
  }
}
</style>
