---
import { type CollectionEntry, getCollection, render } from "astro:content"
import FavouriteButton from "../../components/FavouriteButton.vue"
import Layout from "../../layouts/Layout.astro"

export async function getStaticPaths() {
	const entries = await getCollection("blog", ({ data }) => data.draft !== true)
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry }
	}))
}

interface Props {
	entry: CollectionEntry<"blog">
}

const { entry } = Astro.props
const { Content } = await render(entry)

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("en-GB", {
		year: "numeric",
		month: "long",
		day: "numeric"
	}).format(date)
---

<Layout
  title={`${entry.data.title} - Emmanuel`}
  path="/blog"
  masthead="The Blog"
  section="dispatch">
  <div class="PostFlow" data-flow data-columns>
    <header class="Header" data-label={entry.data.title}>
      <p class="Kicker label">
        <a class="Back" href="/blog">← blog</a>
        <span class="Sep" aria-hidden="true">·</span>
        <time datetime={entry.data.publishDate.toISOString()}>
          {formatDate(entry.data.publishDate)}
        </time>
      </p>
      <h2 class="PostTitle display">{entry.data.title}</h2>
      <p class="Standfirst">{entry.data.description}</p>
      {entry.data.tags.length > 0 && (
        <ul class="Tags">
          {entry.data.tags.map((tag) => <li class="Tag">#{tag}</li>)}
        </ul>
      )}
      <div class="Actions">
        <FavouriteButton client:visible slug={entry.id} />
      </div>
    </header>

    <Content />
  </div>
</Layout>

<style is:global lang="postcss">
/*
 * The header is a band above the columns: part of the screen, not part of the
 * column flow, so the columns start with the whole screen to fill.
 */
/*
 * The header is a banner: kicker and title on one line, then a metadata line. It
 * has to be short, because its height is height the columns cannot use, and a
 * header that filled a third of the screen left the columns too short to hold a
 * paragraph, which produced both gaps and clipped lines.
 */
.Header {
  display: flex;
  flex-direction: column;
  gap: var(--spacing_fluid-tight-space-tight-xs);
  padding-bottom: var(--spacing_fluid-tight-space-tight-s);
  border-bottom: var(--spacing-size-rule) double var(--rule-strong);
}

/* One line of metadata, sitting beside the title on a wide screen. */
@media (min-width: 60rem) {
  .Header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "title meta" "title tags";
    align-items: baseline;
    column-gap: var(--spacing_fluid-column-space-column-s);
  }

  .Header .PostTitle {
    grid-area: title;
  }

  .Header .Kicker {
    grid-area: meta;
    justify-content: flex-end;
  }

  .Header .Tags {
    grid-area: tags;
    justify-content: flex-end;
  }

  .Header .Standfirst,
  .Header .Actions {
    display: none;
  }
}

/* The title and standfirst are a banner, not a page: title on the left, standfirst
   beside it, so the band stays a few lines tall. */
.Header .PostTitle,
.Header .Kicker,
.Header .Tags,
.Header .Actions {
  margin: 0;
}

@media (min-width: 60rem) {
  .Header {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    grid-template-areas: "kicker tags" "title standfirst" "title actions";
    align-items: start;
    column-gap: var(--spacing_fluid-column-space-column-s);
  }

  .Header .Kicker {
    grid-area: kicker;
  }
  .Header .PostTitle {
    grid-area: title;
  }
  .Header .Standfirst {
    grid-area: standfirst;
  }
  .Header .Tags {
    grid-area: tags;
    justify-content: flex-end;
  }
  .Header .Actions {
    grid-area: actions;
    justify-content: flex-end;
  }
}

/*
 * No layout of its own. The paginator sizes the flow to the screen and the
 * browser breaks it into page-width columns; a grid here would ignore the column
 * properties and stack the article into one long column.
 */
.PostFlow {
  display: block;
}

/*
 * Prose keeps a readable measure, so a line does not run the full width of a
 * screen while the layout itself does.
 */
.PostFlow > p,
.PostFlow > blockquote,
.PostFlow > ul,
.PostFlow > ol,
.PostFlow > h2,
.PostFlow > h3,
.PostFlow > h4 {
  max-width: 72ch;
}

.Kicker {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--spacing_fluid-tight-space-tight-s);
  color: var(--muted);
}

.Back:hover {
  color: var(--accent);
}

.PostTitle {
  font-size: var(--typography_fluid-content-font-size-l);
  line-height: 1.1;
  text-wrap: balance;
}

.Standfirst {
  color: var(--muted);
  font-size: var(--typography_fluid-content-font-size-s);
}

.Tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing_fluid-tight-space-tight-m);
  color: var(--faint);
  font-size: var(--typography_fluid-micro-font-size-micro-s);
  letter-spacing: 0.08em;
}

.Actions {
  display: flex;
  padding-top: var(--spacing_fluid-tight-space-tight-xs);
}
</style>
