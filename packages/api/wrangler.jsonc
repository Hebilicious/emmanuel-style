{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "emmanuel-style-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-17",
	"preview_urls": true,
	// The site is a worker of its own on emmanuel.style; this one answers `/api/*` in front of it.
	"routes": [
		{
			"pattern": "emmanuel.style/api/*",
			"zone_name": "emmanuel.style"
		}
	],
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{ "name": "FAVOURITES", "class_name": "Favourites" },
			{ "name": "STAR_CACHE", "class_name": "StarCache" }
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Favourites", "StarCache"]
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://emmanuel.style,http://localhost:4321,http://localhost:4399,http://localhost:4400"
	}
}
