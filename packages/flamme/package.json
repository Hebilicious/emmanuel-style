{
	"name": "@emmanuel/flamme",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "emmanuel.style, built with Flamme, Vize and a Pothos GraphQL backend.",
	"scripts": {
		"dev": "pnpm run cssforge && vite",
		"build": "pnpm run cssforge && tsx ./scripts/build.ts",
		"preview": "vite preview --port 4322",
		"typecheck": "flamme generate && vue-tsc -p tsconfig.json",
		"content": "tsx ./scripts/build-content.ts",
		"content:check": "tsx ./scripts/check-content.ts",
		"cssforge": "tsx ./node_modules/@hebilicious/cssforge/src/cli.ts --prefix . --config ./cssforge.config.ts --mode all --css ./src/styles/cssforge.css --json ./.cssforge/output.json --ts ./.cssforge/output.ts",
		"codegen": "flamme generate"
	},
	"dependencies": {
		"@emmanuel/schema": "workspace:*",
		"@flamme/core": "workspace:*",
		"@flamme/local": "workspace:*",
		"@flamme/router": "workspace:*",
		"@flamme/runtime": "workspace:*",
		"@flamme/vue": "workspace:*",
		"@hebilicious/cssforge": "catalog:astro",
		"@vueuse/core": "catalog:astro",
		"graphql": "16.14.2",
		"vue": "catalog:astro",
		"vue-router": "5.3.1"
	},
	"devDependencies": {
		"@types/hast": "3.0.4",
		"@types/mdast": "4.0.4",
		"@types/node": "24.13.5",
		"@vitejs/plugin-vue": "6.0.8",
		"@vizejs/vite-plugin": "0.424.10",
		"hast-util-from-html": "2.0.3",
		"hast-util-to-html": "9.0.5",
		"hast-util-to-string": "3.0.1",
		"lightningcss": "1.32.0",
		"mdast-util-to-string": "4.0.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "11.0.0",
		"remark-rehype": "11.1.2",
		"tsx": "4.20.0",
		"typescript": "6.0.3",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"vite": "8.3.0",
		"vitest": "5.0.1",
		"vue-tsc": "3.2.4",
		"yaml": "2.9.1",
		"@flamme/cli": "workspace:*",
		"@flamme/vite": "workspace:*"
	}
}
