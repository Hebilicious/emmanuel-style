{
	// The site: the static build in `dist`, served from emmanuel.style.
	// Deployed with the worker package's wrangler: `pnpm --filter @emmanuel/flamme run deploy`.
	"$schema": "../api/node_modules/wrangler/config-schema.json",
	"name": "emmanuel-style",
	"compatibility_date": "2026-09-17",
	"preview_urls": true,
	"routes": [
		{
			"pattern": "emmanuel.style",
			"custom_domain": true
		}
	],
	"assets": {
		"directory": "./dist",
		// Files are served at the paths they have, with no redirect to or from a trailing
		// slash: the service worker stores every file of the build, and a stored redirect
		// cannot answer a navigation.
		"html_handling": "none",
		// An article or a project is a route the app draws, not a file: the shell answers for it.
		"not_found_handling": "single-page-application"
	},
	"observability": {
		"enabled": true
	}
}
