{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The CLI is a Node program: it reads/writes files and inspects `process`.
    // `@types/node` is a devDependency of this package, so the types resolve
    // under pnpm's strict layout. Every other package keeps the base `types: []`.
    "types": ["node"],
    // The runtime barrel's transport seam is DOM-typed and the CLI typechecks it
    // through `@flamme/core`; see the note in packages/core/tsconfig.json.
    "lib": ["ES2023", "DOM"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
