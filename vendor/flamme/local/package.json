{
  "name": "@flamme/local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first layer: durable cache, offline mutations, replay and sync status.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@flamme/runtime": "workspace:*"
  },
  "peerDependencies": {
    "vue": "3.5.42"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@flamme/router": "workspace:*",
    "@flamme/vue": "workspace:*",
    "vue": "3.5.42",
    "vue-router": "5.3.1"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  }
}
