{
  "name": "@flamme/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic compiler, IR and artifact pipeline.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
