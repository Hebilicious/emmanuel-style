      "import": "./dist/sfc.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@flamme/runtime": "workspace:*",
    "@vue/compiler-sfc": "3.5.42",
    "graphql": "16.14.2",
    "oxc-parser": "0.149.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json"
  }
}
