{
  "schemaPath": "./server/schema.graphql",
  "url": "/graphql",
  "include": [
    "src/**/*.{gql,graphql,ts,vue}"
  ],
  "exclude": [
    "server/schema.graphql"
  ],
  "defaultCachePolicy": "NetworkOnly",
  "defaultPartial": true,
  "defaultPaginateMode": "Infinite",
  "defaultListPosition": "first",
  "defaultListTarget": "all",
  "defaultFragmentMasking": "enable",
  "defaultKeys": [
    "id"
  ],
  "types": {
    "Comment": {
      "keys": [
        "id",
        "text"
      ]
    }
  }
}
